{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/superagent/sa room hook pre",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/superagent/sa room hook post",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "85",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000"
  }
}
